# Copy this file to .env and replace CHANGE_ME with the real passwords.
# Never commit .env.
DATABASE_URL=postgresql://pharmaassist_app:CHANGE_ME@localhost:5432/pharmaassist
TEST_DATABASE_URL=postgresql://pharmaassist_test:CHANGE_ME@localhost:5432/pharmaassist_test
REVIEWER_DATABASE_URL=postgresql://pharmaassist_reviewer:CHANGE_ME@localhost:5432/pharmaassist

# Retrieval settings (optional). RETRIEVAL_MIN_SIMILARITY empty = no threshold; a value will be
# chosen through evaluation with real pharmaceutical questions, not guessed.
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=

# Groq answer generation. Put the real key in .env only.
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=openai/gpt-oss-120b
# low, medium or high (openai/gpt-oss-120b)
GROQ_REASONING_EFFORT=low
# Maximum output tokens (reasoning tokens may count towards it)
GROQ_MAX_COMPLETION_TOKENS=4096
GROQ_TIMEOUT_SECONDS=30
